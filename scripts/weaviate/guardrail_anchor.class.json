{
  "class": "GuardrailAnchor",
  "vectorizer": "text2vec-huggingface",
  "moduleConfig": {
    "text2vec-huggingface": {
      "endpointURL": "http://jina-embeddings-v5-text-small.hosted-models.svc.cluster.local",
      "vectorizeClassName": false
    }
  },
  "vectorIndexConfig": {
    "distance": "cosine"
  },
  "properties": [
    {
      "name": "anchorText",
      "dataType": [
        "text"
      ],
      "moduleConfig": {
        "text2vec-huggingface": {
          "skip": false,
          "vectorizePropertyName": false
        }
      }
    },
    {
      "name": "answeredBy",
      "dataType": [
        "GuardrailInstruction"
      ]
    }
  ]
}
